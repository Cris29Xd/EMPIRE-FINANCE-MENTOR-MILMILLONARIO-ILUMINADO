rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isDataOwner(data) { return isSignedIn() && request.auth.uid == data.ownerId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'email']) 
        && data.userId is string && data.userId.size() <= 128
        && data.email is string && data.email.size() <= 256
        && (data.get('displayName', '') is string && data.get('displayName', '').size() <= 128)
        && (data.get('totalNetWorth', 0) is number);
    }

    function isValidAccount(data) {
      return data.keys().hasAll(['name', 'type', 'balance', 'ownerId'])
        && data.name is string && data.name.size() <= 100
        && data.type in ['checking', 'savings', 'credit_card', 'debt', 'investment']
        && data.balance is number
        && data.ownerId == request.auth.uid;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['amount', 'category', 'type', 'date', 'ownerId'])
        && data.amount is number
        && data.category is string && data.category.size() <= 50
        && data.type in ['income', 'expense']
        && data.date is timestamp
        && data.ownerId == request.auth.uid;
    }

    function isValidMentorSession(data) {
      return data.keys().hasAll(['ownerId', 'messages'])
        && data.ownerId == request.auth.uid
        && data.messages is list
        && data.messages.size() <= 1000;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) 
        && isValidUser(incoming())
        && incoming().userId == existing().userId
        && incoming().email == existing().email;
    }

    match /accounts/{accountId} {
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidAccount(incoming()) && isValidId(accountId);
      allow update: if isSignedIn() 
        && resource.data.ownerId == request.auth.uid
        && isValidAccount(incoming())
        && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /transactions/{transactionId} {
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidTransaction(incoming()) && isValidId(transactionId);
      allow update: if isSignedIn() 
        && resource.data.ownerId == request.auth.uid
        && isValidTransaction(incoming())
        && incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /mentorship/{sessionId} {
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidMentorSession(incoming()) && isValidId(sessionId);
      allow update: if isSignedIn() 
        && resource.data.ownerId == request.auth.uid
        && isValidMentorSession(incoming())
        && incoming().ownerId == existing().ownerId;
    }
  }
}
