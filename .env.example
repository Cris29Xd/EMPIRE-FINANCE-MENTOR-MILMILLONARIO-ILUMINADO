# ============================================================
#  EMPIRE FINANCE — Variables de entorno
#  Copia este archivo como .env y rellena tus valores reales.
#  NUNCA subas .env a git (ya está en .gitignore).
# ============================================================

# OpenAI API Key — https://platform.openai.com/api-keys
# Modelos usados:
#   Mentor chat  → gpt-4o        (streaming)
#   Insight diario → gpt-4o-mini  (rápido y económico)
OPENAI_API_KEY="sk-proj-..."

# Puerto del servidor Express (default: 3001)
# Vite hace proxy de /api → http://localhost:${API_PORT}
API_PORT=3001
