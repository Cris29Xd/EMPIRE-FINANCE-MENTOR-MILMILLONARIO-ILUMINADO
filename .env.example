# ============================================================
#  EMPIRE FINANCE / SYNAPTIK BRAIN — Variables de entorno
#  Copia este archivo como .env.local y rellena tus valores.
#  NUNCA subas .env.local a git (ya está en .gitignore).
# ============================================================

# DeepSeek API Key — https://platform.deepseek.com/api_keys
# Modelos usados:
#   Mentor chat    → deepseek-chat  (streaming)
#   Insight diario → deepseek-chat  (rápido y económico)
DEEPSEEK_API_KEY="sk-..."

# Token de acceso a la app (cualquier string seguro)
ACCESS_TOKEN="tu-token-secreto"

# Puerto del servidor Express (default: 3001)
API_PORT=3001
